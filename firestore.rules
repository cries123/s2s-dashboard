rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Primitives & Safety ---
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    // Role checks with master decimal/string override
    function isAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             (request.auth.token.email.lower() == 'jaryn.b.healey@gmail.com' ||
              request.auth.token.email.lower() == 'jaryn.healey@hyundaigp.com' ||
              (exists(/databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isApproved() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             (request.auth.token.email.lower() == 'jaryn.b.healey@gmail.com' ||
              request.auth.token.email.lower() == 'jaryn.healey@hyundaigp.com' ||
              (exists(/databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid)).data.status == 'approved'));
    }

    // --- Users Collection ---
    match /artifacts/hyundai-sales-to-service/public/data/users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Settings & Metadata ---
    match /artifacts/hyundai-sales-to-service/public/data/dealershipSettings/{dealershipId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Customer & Operations Data ---
    match /artifacts/hyundai-sales-to-service/public/data/customers/{customerId} {
      allow read, write: if isApproved() || isAdmin();
      
      match /contactLog/{logId} {
        allow read, write: if isApproved() || isAdmin();
      }
    }

    match /artifacts/hyundai-sales-to-service/public/data/appointmentTracker/{date=**} {
      allow read, write: if isApproved() || isAdmin();
    }

    match /artifacts/hyundai-sales-to-service/public/data/dispatchOrders/{orderId} {
      allow read, write: if isApproved() || isAdmin();
    }

    // --- Performance Tracking ---
    match /artifacts/hyundai-sales-to-service/public/data/performance/{docId} {
      allow read, write: if isApproved() || isAdmin();
    }

    // --- AI Usage Logs ---
    match /artifacts/hyundai-sales-to-service/public/data/aiUsageLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // --- Audit Logs (Import History) ---
    match /artifacts/hyundai-sales-to-service/public/audit/imports/{docId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // --- System Activity Logs ---
    match /artifacts/hyundai-sales-to-service/public/audit/systemLogs/{logId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isSignedIn();
    }

  }
}

