rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function userDocPath() {
      return /databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function userTenantId() {
      return userExists() && 'tenantId' in userData()
        ? userData().tenantId
        : (userExists() && userData().dealershipId == 'nissan'
            ? 'nissan-mazda'
            : (userExists() && userData().dealershipId == 'ford'
                ? 'ford-lincoln'
                : 'hyundai'));
    }

    function isProtectedAccount(data) {
      return data.email == 'admin@hyundai.com';
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             (request.auth.token.email == 'admin@hyundai.com' ||
              request.auth.token.email == 'jaryn.b.healey@gmail.com' ||
              request.auth.token.email == 'Jaryn.B.Healey@gmail.com' ||
              request.auth.token.email == 'jaryn.healey@hyundaigp.com' ||
              request.auth.token.email == 'Jaryn.Healey@hyundaigp.com' ||
              (userExists() && userData().role == 'admin'));
    }

    function isApproved() {
      return isAdmin() ||
             (userExists() &&
              (userData().approved == true ||
               userData().status == 'approved' ||
               userData().role == 'admin'));
    }

    function isTenantManager() {
      return userExists() &&
             isApproved() &&
             (userData().role == 'manager' ||
              userData().role == 'Manager' ||
              userData().isManager == true);
    }

    function isManagerForTenant(tenantId) {
      return isTenantManager() && userTenantId() == tenantId;
    }

    function isSystemWorker() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'system-worker@hyundai-s2s.internal';
    }

    function sameTenantAsActor(data) {
      return ('tenantId' in data && data.tenantId == userTenantId()) ||
             (!('tenantId' in data) && userExists() && data.dealershipId == userData().dealershipId);
    }

    function isStaffTarget(data) {
      return !(data.role == 'admin' ||
               data.role == 'manager' ||
               data.role == 'Manager' ||
               data.isManager == true);
    }

    function managerCannotPromoteToManager() {
      return !(incoming().role == 'admin' ||
               incoming().role == 'manager' ||
               incoming().role == 'Manager' ||
               incoming().isManager == true);
    }

    function tenantUnchanged() {
      return !('tenantId' in incoming()) || incoming().tenantId == resource.data.tenantId;
    }

    function isManagerRoleValue(data) {
      return data.role == 'manager' || data.role == 'Manager' || data.isManager == true;
    }

    // A user who self-selected "manager" at signup sits in the pending-enrollment
    // queue with approved == false. Approving them only flips approved/status —
    // it isn't a promotion, so it's exempted from managerCannotPromoteToManager()
    // and isStaffTarget() below. incoming().role != 'admin' is a hard backstop so
    // this path can never be used to grant admin.
    function isApprovingPendingManager() {
      return resource.data.approved == false &&
             isManagerRoleValue(resource.data) &&
             isManagerRoleValue(incoming()) &&
             incoming().approved == true &&
             incoming().role != 'admin';
    }

    // --- Users Collection ---
    match /artifacts/hyundai-sales-to-service/public/data/users/{userId} {
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().tenantId is string &&
                       incoming().department in ['sales', 'service'] &&
                       (incoming().role == 'pending' || incoming().role == 'manager' || incoming().role == 'Manager') &&
                       incoming().approved == false;

      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSystemWorker() ||
        (isApproved() && sameTenantAsActor(resource.data)) ||
        (isTenantManager() && sameTenantAsActor(resource.data))
      );

      // NOTE: isTenantManager() must stay paired with sameTenantAsActor() here — unlike
      // get() (single doc), list() queries an entire collection, and an unscoped
      // isTenantManager() would let any manager list every user across every dealership.
      allow list: if isAdmin() || isSystemWorker() ||
        (isTenantManager() && sameTenantAsActor(resource.data)) ||
        (isApproved() && sameTenantAsActor(resource.data));

      allow update: if isAdmin() ||
        (isTenantManager() &&
         sameTenantAsActor(resource.data) &&
         request.auth.uid != userId &&
         !isProtectedAccount(resource.data) &&
         (isStaffTarget(resource.data) || isApprovingPendingManager()) &&
         (managerCannotPromoteToManager() || isApprovingPendingManager()) &&
         tenantUnchanged()) ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']));

      allow delete: if isAdmin() ||
        (isTenantManager() &&
         sameTenantAsActor(resource.data) &&
         request.auth.uid != userId &&
         !isProtectedAccount(resource.data) &&
         isStaffTarget(resource.data));
    }

    // --- Tenant profiles (DMS + metadata) ---
    match /artifacts/hyundai-sales-to-service/public/data/tenants/{tenantId} {
      allow read: if isSignedIn() && (isAdmin() || userTenantId() == tenantId);
      allow create, update: if isAdmin() || isManagerForTenant(tenantId);
      allow delete: if isAdmin();
    }

    // --- Tenant-scoped audit logs ---
    match /artifacts/hyundai-sales-to-service/public/data/logs/{logId} {
      allow create: if isSignedIn() &&
                       incoming().tenantId is string &&
                       (isAdmin() || incoming().tenantId == userTenantId());
      allow read: if isAdmin() || (isTenantManager() && resource.data.tenantId == userTenantId());
      allow update, delete: if isAdmin();
    }

    // --- Settings & Metadata ---
    match /artifacts/hyundai-sales-to-service/public/data/dealershipSettings/{dealershipId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() ||
        (isTenantManager() && userExists() && userData().dealershipId == dealershipId);
    }

    function userDealershipId() {
      return userExists() && 'dealershipId' in userData() && userData().dealershipId is string
        ? userData().dealershipId
        : (userTenantId() == 'nissan-mazda'
            ? 'nissan'
            : (userTenantId() == 'ford-lincoln' ? 'ford' : 'hyundai'));
    }

    // Docs written before multi-tenant support carry no dealershipId and belonged to
    // Hyundai (the original single-tenant dataset). Safe for single-doc get()/write
    // checks; NOT safe for list/query rules, which must match an explicit, queryable
    // where('dealershipId','==', ...) clause — see the `allow list` rules below.
    function docBelongsToActor(data) {
      return ('dealershipId' in data && data.dealershipId is string)
        ? data.dealershipId == userDealershipId()
        : userDealershipId() == 'hyundai';
    }

    function canAccessDispatchData(data) {
      return isAdmin() ||
             isSystemWorker() ||
             (userExists() && data.dealershipId == userDealershipId());
    }

    // --- Customer & Operations Data ---
    match /artifacts/hyundai-sales-to-service/public/data/customers/{customerId} {
      allow get: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));
      allow list: if isAdmin() || isSystemWorker() || (isApproved() && resource.data.dealershipId == userDealershipId());
      allow create: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(incoming()));
      allow update: if isAdmin() || isSystemWorker() ||
                       (isApproved() && docBelongsToActor(resource.data) && docBelongsToActor(incoming()));
      allow delete: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));

      match /contactLog/{logId} {
        allow read, write: if isAdmin() || isSystemWorker() ||
          (isApproved() &&
           docBelongsToActor(get(/databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/customers/$(customerId)).data));
      }
    }

    match /artifacts/hyundai-sales-to-service/public/data/appointmentTracker/{docId} {
      allow get: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));
      allow list: if isAdmin() || isSystemWorker() || (isApproved() && resource.data.dealershipId == userDealershipId());
      allow create: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(incoming()));
      allow update: if isAdmin() || isSystemWorker() ||
                       (isApproved() && docBelongsToActor(resource.data) && docBelongsToActor(incoming()));
      allow delete: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));
    }

    match /artifacts/hyundai-sales-to-service/public/data/appointmentSchedule/{docId} {
      allow get: if isAdmin() || isSystemWorker() || (isApproved() && resource.data.dealershipId == userDealershipId());
      allow create: if isAdmin() || isSystemWorker() || (isApproved() && incoming().dealershipId == userDealershipId());
      allow update: if isAdmin() || isSystemWorker() ||
                       (isApproved() &&
                        resource.data.dealershipId == userDealershipId() &&
                        incoming().dealershipId == userDealershipId());
      allow delete: if isAdmin() || isSystemWorker() || (isApproved() && resource.data.dealershipId == userDealershipId());
    }

    match /artifacts/hyundai-sales-to-service/public/data/dispatchOrders/{orderId} {
      allow read: if (isApproved() || isSystemWorker()) && canAccessDispatchData(resource.data);

      allow create: if (isApproved() || isSystemWorker()) &&
                       incoming().dealershipId is string &&
                       canAccessDispatchData(incoming());

      allow update: if (isApproved() || isSystemWorker()) &&
                       canAccessDispatchData(resource.data) &&
                       (isAdmin() || isSystemWorker() || incoming().dealershipId == resource.data.dealershipId);

      allow delete: if (isApproved() || isSystemWorker()) && canAccessDispatchData(resource.data);
    }

    match /artifacts/hyundai-sales-to-service/public/data/vehicleInventory/{vehicleId} {
      allow read: if (isApproved() || isAdmin() || isSystemWorker()) &&
                     resource.data.dealershipId == userDealershipId();
      allow write: if isAdmin() || isSystemWorker();
    }

    // vehicleRecalls: the only client feature that read/wrote this collection
    // (VehicleRecalls.tsx) was unreachable dead code and has been removed. No
    // explicit rule here means the top-level `allow read, write: if false` at
    // the top of this file applies — locked down until a real, tenant-scoped
    // feature needs it again.

    match /artifacts/hyundai-sales-to-service/public/data/recallCampaignLeads/{leadId} {
      allow get: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));
      allow list: if isAdmin() || isSystemWorker() || (isApproved() && resource.data.dealershipId == userDealershipId());
      allow create: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(incoming()));
      allow update: if isAdmin() || isSystemWorker() ||
                       (isApproved() && docBelongsToActor(resource.data) && docBelongsToActor(incoming()));
      allow delete: if isAdmin() || isSystemWorker() || (isApproved() && docBelongsToActor(resource.data));
    }

    // --- Performance Tracking (always accessed by a specific tenant-scoped
    // doc id — never listed as a collection — so a single docBelongsToActor
    // check on get()/write() is sufficient here). ---
    match /artifacts/hyundai-sales-to-service/public/data/performance/{docId} {
      allow get: if isAdmin() || (isApproved() && docBelongsToActor(resource.data));
      allow create: if isAdmin() || (isApproved() && docBelongsToActor(incoming()));
      allow update: if isAdmin() || (isApproved() && docBelongsToActor(resource.data) && docBelongsToActor(incoming()));
      allow delete: if isAdmin() || (isApproved() && docBelongsToActor(resource.data));
    }

    // --- AI Usage Logs ---
    match /artifacts/hyundai-sales-to-service/public/data/aiUsageLogs/{logId} {
      // Only approved staff (or admins) generate real usage — signed-in-but-pending
      // accounts have no legitimate reason to write here.
      allow create: if isApproved();
      allow read: if isAdmin();
    }

    // --- Audit Logs (Import History) ---
    match /artifacts/hyundai-sales-to-service/public/audit/imports/{docId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // --- System Activity Logs ---
    match /artifacts/hyundai-sales-to-service/public/audit/systemLogs/{logId} {
      allow read: if isApproved() || isAdmin() || (isTenantManager() && resource.data.dealershipId == userData().dealershipId);
      // Was `isSignedIn()` — let any pending/unapproved account write audit-log
      // entries. Approved staff, admins, and the internal sync worker only.
      allow write: if isApproved() || isAdmin() || isSystemWorker();
    }

    // --- Tenant-scoped dealership chat (dispatch ↔ advisors) ---
    match /artifacts/hyundai-sales-to-service/public/data/dealershipChatMessages/{messageId} {
      allow read: if isApproved() &&
                     resource.data.dealershipId == userDealershipId() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid == request.auth.uid);

      allow create: if isApproved() &&
                       incoming().dealershipId == userDealershipId() &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().toUid is string &&
                       incoming().toUid != request.auth.uid &&
                       incoming().fromName is string &&
                       incoming().toName is string &&
                       incoming().threadKey is string &&
                       incoming().body is string &&
                       incoming().body.size() > 0 &&
                       incoming().body.size() <= 500 &&
                       incoming().createdAt is string;

      allow update: if isApproved() &&
                       resource.data.toUid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt', 'readAt']);
    }

    // --- User suggestions (top-bar feedback) ---
    match /artifacts/hyundai-sales-to-service/public/data/suggestions/{suggestionId} {
      allow create: if isApproved() &&
                       incoming().message is string &&
                       incoming().message.size() > 0 &&
                       incoming().message.size() <= 2000 &&
                       incoming().userId == request.auth.uid &&
                       incoming().userEmail is string &&
                       incoming().username is string &&
                       incoming().dealershipId is string &&
                       incoming().status == 'new';

      allow read, update, delete: if isAdmin();
    }
  }
}
