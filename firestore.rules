rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function userDocPath() {
      return /databases/$(database)/documents/artifacts/hyundai-sales-to-service/public/data/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function userTenantId() {
      return userExists() && 'tenantId' in userData()
        ? userData().tenantId
        : (userExists() && userData().dealershipId == 'nissan'
            ? 'nissan-mazda'
            : (userExists() && userData().dealershipId == 'ford'
                ? 'ford-lincoln'
                : 'hyundai'));
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             (request.auth.token.email == 'jaryn.b.healey@gmail.com' ||
              request.auth.token.email == 'Jaryn.B.Healey@gmail.com' ||
              request.auth.token.email == 'jaryn.healey@hyundaigp.com' ||
              request.auth.token.email == 'Jaryn.Healey@hyundaigp.com' ||
              (userExists() && userData().role == 'admin'));
    }

    function isApproved() {
      return isAdmin() ||
             (userExists() &&
              (userData().approved == true ||
               userData().status == 'approved' ||
               userData().role == 'admin'));
    }

    function isTenantManager() {
      return userExists() &&
             isApproved() &&
             (userData().role == 'manager' ||
              userData().role == 'Manager' ||
              userData().isManager == true);
    }

    function isManagerForTenant(tenantId) {
      return isTenantManager() && userTenantId() == tenantId;
    }

    function isSystemWorker() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'system-worker@hyundai-s2s.internal';
    }

    function tenantUnchanged() {
      return !('tenantId' in incoming()) || incoming().tenantId == resource.data.tenantId;
    }

    // --- Users Collection ---
    match /artifacts/hyundai-sales-to-service/public/data/users/{userId} {
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().tenantId is string &&
                       incoming().department in ['sales', 'service'] &&
                       incoming().role == 'pending' &&
                       incoming().approved == false;

      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSystemWorker() ||
        (isTenantManager() && resource.data.tenantId == userTenantId())
      );

      allow list: if isAdmin() || isSystemWorker() || isTenantManager();

      allow update: if isAdmin() ||
        (isTenantManager() &&
         resource.data.tenantId == userTenantId() &&
         request.auth.uid != userId &&
         tenantUnchanged() &&
         incoming().tenantId == resource.data.tenantId) ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']));

      allow delete: if isAdmin();
    }

    // --- Tenant profiles (DMS + metadata) ---
    match /artifacts/hyundai-sales-to-service/public/data/tenants/{tenantId} {
      allow read: if isSignedIn() && (isAdmin() || userTenantId() == tenantId);
      allow create, update: if isAdmin() || isManagerForTenant(tenantId);
      allow delete: if isAdmin();
    }

    // --- Tenant-scoped audit logs ---
    match /artifacts/hyundai-sales-to-service/public/data/logs/{logId} {
      allow create: if isSignedIn() &&
                       incoming().tenantId is string &&
                       (isAdmin() || incoming().tenantId == userTenantId());
      allow read: if isAdmin() || (isTenantManager() && resource.data.tenantId == userTenantId());
      allow update, delete: if isAdmin();
    }

    // --- Settings & Metadata ---
    match /artifacts/hyundai-sales-to-service/public/data/dealershipSettings/{dealershipId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Customer & Operations Data ---
    match /artifacts/hyundai-sales-to-service/public/data/customers/{customerId} {
      allow read, write: if isApproved() || isAdmin() || isSystemWorker();

      match /contactLog/{logId} {
        allow read, write: if isApproved() || isAdmin() || isSystemWorker();
      }
    }

    match /artifacts/hyundai-sales-to-service/public/data/appointmentTracker/{date=**} {
      allow read, write: if isApproved() || isAdmin() || isSystemWorker();
    }

    match /artifacts/hyundai-sales-to-service/public/data/dispatchOrders/{orderId} {
      allow read, write: if isApproved() || isAdmin() || isSystemWorker();
    }

    match /artifacts/hyundai-sales-to-service/public/data/vehicleRecalls/{recallId} {
      allow read, write: if isApproved() || isAdmin() || isSystemWorker();
    }

    // --- Performance Tracking ---
    match /artifacts/hyundai-sales-to-service/public/data/performance/{docId} {
      allow read, write: if isApproved() || isAdmin();
    }

    // --- AI Usage Logs ---
    match /artifacts/hyundai-sales-to-service/public/data/aiUsageLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // --- Audit Logs (Import History) ---
    match /artifacts/hyundai-sales-to-service/public/audit/imports/{docId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // --- System Activity Logs ---
    match /artifacts/hyundai-sales-to-service/public/audit/systemLogs/{logId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isSignedIn();
    }
  }
}
