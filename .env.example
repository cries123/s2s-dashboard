# Optional — local development only. Production keys live in Netlify (see README).
# UI preview without login (local dev only — ignored in production builds):
# VITE_PREVIEW_MODE=true
# Or run: npm run dev:preview
# Or open: http://localhost:5173/service/dispatch?preview=true
# Copy to .env.local ONLY if you run `npm run dev` on your machine.
# Dealership users on the live site do NOT need any local env files.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only (Netlify Functions env in production — never VITE_* prefix)
OPENAI_API_KEY=
GEMINI_API_KEY=
SYSTEM_WORKERS_PASSWORD=

# PBS automated sync (cron + manual POST /api/pbs/sync/run)
PBS_SYNC_SECRET=

# Server-only — required for PBS sync writes to Firestore (paste entire downloaded JSON file)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional alternative if Netlify mangles multiline JSON — base64-encode the whole JSON file
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# PBS PartnerHUB (Hyundai of Santa Maria — serial 8200)
# Partner login from PBS Partner registration (Basic Auth). Serial/access code from PBS email.
PBS_PARTNER_USERNAME=
PBS_PARTNER_PASSWORD=
PBS_SERIAL_NUMBER=8200
# PBS_API_BASE_URL=https://partnerhub.pbsdealers.com
