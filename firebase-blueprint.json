{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account details and enrollment status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "Manager", "Salesperson", "Service Advisor", "Staff"] },
        "jobTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "dealershipId": { "type": "string" },
        "isManager": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "username", "role", "status"]
    },
    "Dealership": {
      "title": "Dealership",
      "description": "Dealership details and join codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code"]
    },
    "DailyStat": {
      "title": "Daily Appointment Stat",
      "description": "Total count of appointments for a specific day",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "count": { "type": "number", "description": "Total appointments for the day" },
        "updatedBy": { "type": "string", "description": "User UID who last updated" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "count"]
    },
    "ImportLog": {
      "title": "Database Import Log",
      "description": "Records of CSV or PDF database synchronization events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "filename": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "totalRecords": { "type": "number" },
        "newProfiles": { "type": "number" },
        "matchedProfiles": { "type": "number" },
        "visitsLogged": { "type": "number" },
        "duplicates": { "type": "number" },
        "type": { "type": "string", "enum": ["pdf", "csv"] }
      },
      "required": ["userId", "filename", "timestamp", "totalRecords", "type"]
    },
    "PotOfGoldConfig": {
      "title": "Pot of Gold Configuration",
      "description": "Shared configuration for the Pot of Gold competition",
      "type": "object",
      "properties": {
        "advData": { "type": "array" },
        "techData": { "type": "array" },
        "prices": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "AdvisorPerformanceReport": {
      "title": "Advisor Performance Report",
      "description": "Aggregated advisor performance data from CSR reports",
      "type": "object",
      "properties": {
        "advisors": { "type": "array" },
        "totals": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "FixedOpsForecastReport": {
      "title": "Fixed Ops Forecast Report",
      "description": "Persisted forecaster parameters, inputs, rawCounts, and telemetry data",
      "type": "object",
      "properties": {
        "inputs": { "type": "object" },
        "rawCounts": { "type": "object" },
        "mtdTelemetry": { "type": "object" },
        "activePreset": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "DispatchRepairOrder": {
      "title": "Dispatch Repair Order",
      "description": "Custom Departmental Dispatch Board repair order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roNumber": { "type": "string" },
        "techNumber": { "type": "string" },
        "vinLastEight": { "type": "string" },
        "department": { "type": "string", "enum": ["lube", "quick_service", "ac_electrical", "heavyline", "diesel", "trans", "mobile_repair", "unassigned"] },
        "status": { "type": "string", "enum": ["WIP", "DIS", "POO", "WFA"] },
        "isCompleted": { "type": "boolean" },
        "dateCreated": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "dealershipId": { "type": "string" }
      },
      "required": ["id", "roNumber", "techNumber", "vinLastEight", "department", "status", "isCompleted", "dateCreated", "lastUpdated", "dealershipId"]
    }
  },
  "firestore": {
    "artifacts/hyundai-sales-to-service/public/data/dispatchOrders": {
      "schema": "DispatchRepairOrder",
      "description": "Repair orders tracked in the Departmental Dispatch Board"
    },
    "artifacts/hyundai-sales-to-service/public/data/appointmentTracker": {
      "schema": "DailyStat",
      "description": "Daily appointment aggregations"
    },
    "artifacts/hyundai-sales-to-service/public/data/users": {
      "schema": "User",
      "description": "User profiles and enrollment status"
    },
    "artifacts/hyundai-sales-to-service/public/data/performance/potOfGold": {
      "schema": "PotOfGoldConfig",
      "description": "Pot of Gold competition data"
    },
    "artifacts/hyundai-sales-to-service/public/data/performance/advisorReports": {
      "schema": "AdvisorPerformanceReport",
      "description": "Advisor performance tracking data"
    },
    "artifacts/hyundai-sales-to-service/public/data/performance/forecastReport": {
      "schema": "FixedOpsForecastReport",
      "description": "Fixed Ops financial forecasting inputs and telemetry data"
    },
    "artifacts/hyundai-sales-to-service/public/audit/imports": {
      "schema": "ImportLog",
      "description": "History of data import operations"
    },
    "artifacts/hyundai-sales-to-service/public/data/aiUsageLogs": {
      "description": "AI Token usage and cost tracking logs"
    }
  }
}
