{
  "manifest_version": 3,
  "name": "S2S WebDCS Assistant",
  "description": "Reads DCM case counts from your own authenticated WebDCS tab and reports them to the S2S Dashboard. Never handles credentials or 2FA.",
  "version": "0.4.0",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://wdcs.hyundaidealer.com/*",
    "https://*.hyundaidealer.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://salestoservice.net/*",
      "http://localhost/*"
    ]
  },
  "icons": {}
}
